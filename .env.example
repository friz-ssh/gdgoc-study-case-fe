# All optional.
# Upstream API (read at build time by the rewrite in next.config.ts)
GDGOC_API_UPSTREAM=https://gdgoc-ugm-api.vercel.app/api
# Base URL the browser calls. Default "/gdgoc-api" goes through the Next.js rewrite (no CORS).
# NEXT_PUBLIC_API_BASE_URL=/gdgoc-api
# If set, the contact form POSTs JSON here; otherwise submission is simulated.
# NEXT_PUBLIC_INQUIRY_ENDPOINT=
